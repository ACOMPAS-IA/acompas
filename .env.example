# ACOMPAS - Configuración local de desarrollo

POSTGRES_DB=acompas
POSTGRES_USER=acompas
POSTGRES_PASSWORD=acompas_dev
POSTGRES_PORT=5432

KEYCLOAK_PORT=8080
KEYCLOAK_BOOTSTRAP_ADMIN_USER=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=acompas_dev

FRONTEND_PORT=5173

# Validación del JWT (ACO-014). El issuer es el valor público que viaja en el
# token y sigue a KEYCLOAK_PORT: vacío, Compose usa
# http://localhost:${KEYCLOAK_PORT}/realms/acompas. El JWKS va por la red de
# Compose al puerto 8080 del contenedor, así que no cambia con KEYCLOAK_PORT.
# Fuera de Compose, pon el issuer y el JWKS del host donde escuches.
KEYCLOAK_ISSUER=
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/acompas/protocol/openid-connect/certs

# Claude API (LLM gateway). La clave va solo en tu .env local: nunca se sube
# al repositorio. LLM_MODEL no tiene valor por defecto. Vacías: valores por defecto.
ANTHROPIC_API_KEY=
LLM_MODEL=
LLM_MAX_OUTPUT_TOKENS=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=

# Umbrales de anonimización (ACO-023). Vacías: 0,35 y 0,85. Deben estar entre
# 0 y 1, y el de hallazgo no puede superar al de documento; un valor inválido
# impide procesar el documento.
ANONYMIZATION_FINDING_THRESHOLD=
ANONYMIZATION_DOCUMENT_THRESHOLD=
